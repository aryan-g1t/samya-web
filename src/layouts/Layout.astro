---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sāmya: — Beauty, informed by you",
  description = "Sāmya: is building a more thoughtful way to discover complexion shades, beginning with India's diverse skin tones. Help shape our founding research."
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#F5EFE8" />
  <meta name="description" content={description} />
  <title>{title}</title>
  
  <!-- Font Preconnect & Zero-CLS Preloading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link 
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;450;500;550;600;650;700&display=swap" 
    rel="stylesheet" 
  />
</head>
<body>
  <div class="spectrum-line" aria-hidden="true"></div>
  <slot />
</body>
</html>
