---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sāmya: Admin Console">
  <div id="admin-root" class="admin-app">
    <!-- Header -->
    <header class="admin-topbar">
      <div class="topbar-inner">
        <div class="brand-group">
          <a href="/" class="brand-logo" aria-label="Sāmya Home">
            <img src="/images/logo-white.png" alt="Sāmya:" class="admin-logo-img" />
          </a>
          <span class="portal-badge">ADMIN CONSOLE</span>
        </div>
        <div class="topbar-user" id="topbar-user" style="display: none;">
          <span class="user-greeting">Signed in as <strong id="current-username">admin</strong></span>
          <button type="button" class="btn-logout" id="btn-logout">Sign Out</button>
        </div>
      </div>
    </header>

    <!-- Spectrum Bar -->
    <div class="spectrum-bar"></div>

    <!-- MAIN CONTAINER -->
    <main class="admin-main">
      <!-- 1. LOGIN VIEW -->
      <section id="login-view" class="view-login">
        <div class="login-card">
          <p class="login-eyebrow">RESTRICTED ACCESS</p>
          <h1 class="login-title">Sāmya: Research Console</h1>
          <p class="login-desc">Enter administrator credentials to manage participant cohorts, view shade discovery analytics, and export dataset records.</p>

          <form id="login-form" class="login-form">
            <div id="login-error" class="login-alert" style="display: none;"></div>

            <div class="field-group">
              <label for="username">USERNAME</label>
              <input type="text" id="username" name="username" placeholder="Enter username" required autocomplete="username" />
            </div>

            <div class="field-group">
              <label for="password">PASSWORD</label>
              <input type="password" id="password" name="password" placeholder="Enter password" required autocomplete="current-password" />
            </div>

            <button type="submit" id="btn-login" class="btn-primary-admin">
              Sign In to Console →
            </button>
          </form>

          <div class="login-footer">
            <span>Encrypted Session · Strict Access Control</span>
          </div>
        </div>
      </section>

      <!-- 2. DASHBOARD VIEW (Shown once authenticated) -->
      <section id="dashboard-view" class="view-dashboard" style="display: none;">
        <!-- KPI Metrics Grid -->
        <div class="kpi-grid">
          <div class="kpi-card">
            <p class="kpi-label">TOTAL PARTICIPANTS</p>
            <h3 class="kpi-value" id="kpi-total">0</h3>
            <p class="kpi-sub">Total registered cohort</p>
          </div>
          <div class="kpi-card">
            <p class="kpi-label">FULL PROFILES</p>
            <h3 class="kpi-value" id="kpi-full">0</h3>
            <p class="kpi-sub" id="kpi-completion-rate">0% completion rate</p>
          </div>
          <div class="kpi-card">
            <p class="kpi-label">KIT TESTING CANDIDATES</p>
            <h3 class="kpi-value" id="kpi-candidates">0</h3>
            <p class="kpi-sub">Consented to sample vials</p>
          </div>
          <div class="kpi-card kpi-spectrum-card">
            <p class="kpi-label">SHADE DEPTH BALANCE</p>
            <div class="depth-bars">
              <div class="depth-bar-row">
                <span class="depth-name">Fair</span>
                <div class="progress-track"><div id="depth-bar-fair" class="progress-bar bar-fair"></div></div>
                <span class="depth-count" id="depth-count-fair">0</span>
              </div>
              <div class="depth-bar-row">
                <span class="depth-name">Medium</span>
                <div class="progress-track"><div id="depth-bar-medium" class="progress-bar bar-medium"></div></div>
                <span class="depth-count" id="depth-count-medium">0</span>
              </div>
              <div class="depth-bar-row">
                <span class="depth-name">Rich</span>
                <div class="progress-track"><div id="depth-bar-rich" class="progress-bar bar-rich"></div></div>
                <span class="depth-count" id="depth-count-rich">0</span>
              </div>
              <div class="depth-bar-row">
                <span class="depth-name">Deep</span>
                <div class="progress-track"><div id="depth-bar-deep" class="progress-bar bar-deep"></div></div>
                <span class="depth-count" id="depth-count-deep">0</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Filter & Search Controls Bar -->
        <div class="controls-card">
          <div class="search-row">
            <div class="search-wrap">
              <span class="search-icon">🔍</span>
              <input type="text" id="filter-search" class="search-input" placeholder="Search by Name, Email, Phone, ID, City, Brand..." />
              <button type="button" id="btn-clear-search" class="btn-clear-search" style="display: none;">✕</button>
            </div>
            <div class="action-buttons">
              <button type="button" class="btn-ctrl btn-add" id="btn-open-create">
                + Add Participant
              </button>
              <button type="button" class="btn-ctrl btn-export" id="btn-export-csv">
                📥 Export CSV
              </button>
              <button type="button" class="btn-ctrl btn-copy" id="btn-copy-emails">
                📋 Copy Emails
              </button>
            </div>
          </div>

          <!-- Faceted Filters -->
          <div class="filters-row">
            <div class="filter-group">
              <span class="filter-label">DEPTH:</span>
              <div class="filter-pills" id="depth-pills">
                <button type="button" class="pill active" data-depth="all">All</button>
                <button type="button" class="pill" data-depth="fair">Fair</button>
                <button type="button" class="pill" data-depth="medium">Medium</button>
                <button type="button" class="pill" data-depth="rich">Rich</button>
                <button type="button" class="pill" data-depth="deep">Deep</button>
              </div>
            </div>

            <div class="filter-group">
              <span class="filter-label">KIT STATUS:</span>
              <select id="filter-kit" class="select-filter">
                <option value="all">All Statuses</option>
                <option value="pending">Pending</option>
                <option value="kit sent">Kit Sent</option>
                <option value="delivered">Delivered</option>
                <option value="archived">Archived</option>
              </select>
            </div>

            <div class="filter-group">
              <span class="filter-label">COMPLETION:</span>
              <select id="filter-completion" class="select-filter">
                <option value="all">All Submissions</option>
                <option value="full">Full Profile Only</option>
                <option value="milestone">Initial Milestone</option>
              </select>
            </div>

            <div class="record-counter">
              Showing <strong id="record-filtered-count">0</strong> of <span id="record-total-count">0</span>
            </div>
          </div>
        </div>

        <!-- Responses Table -->
        <div class="table-card">
          <div class="table-responsive">
            <table class="data-table" id="data-table">
              <thead>
                <tr>
                  <th>PARTICIPANT ID</th>
                  <th>FULL NAME</th>
                  <th>CONTACT</th>
                  <th>LOCATION</th>
                  <th>SKIN DEPTH & UNDERTONE</th>
                  <th>COMPLETION</th>
                  <th>KIT STATUS</th>
                  <th style="text-align: right;">ACTIONS</th>
                </tr>
              </thead>
              <tbody id="table-body">
                <tr>
                  <td colspan="8" class="empty-cell">Loading participant cohort...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <!-- 3. SLIDE-OUT DETAIL & EDIT DRAWER -->
    <div id="drawer-overlay" class="drawer-overlay" style="display: none;"></div>
    <aside id="detail-drawer" class="detail-drawer">
      <div class="drawer-header">
        <div>
          <span class="drawer-eyebrow">PARTICIPANT PROFILE</span>
          <h2 class="drawer-title" id="drawer-participant-id">SAM-000000</h2>
        </div>
        <button type="button" class="btn-close-drawer" id="btn-close-drawer">✕</button>
      </div>

      <div class="drawer-body" id="drawer-body">
        <form id="edit-entry-form">
          <!-- Management Box -->
          <div class="mgmt-box">
            <h4 class="mgmt-title">Testing Kit Management</h4>
            <div class="mgmt-row">
              <div class="field-group">
                <label for="edit-kit-status">KIT STATUS</label>
                <select id="edit-kit-status" class="mgmt-select">
                  <option value="Pending">Pending Review</option>
                  <option value="Kit Sent">Kit Sent</option>
                  <option value="Delivered">Delivered</option>
                  <option value="Archived">Archived</option>
                </select>
              </div>
            </div>
            <div class="field-group" style="margin-top: 12px;">
              <label for="edit-internal-notes">INTERNAL RESEARCH NOTES</label>
              <textarea id="edit-internal-notes" rows="3" class="mgmt-textarea" placeholder="Add tracking numbers, sample shades sent, or custom notes..."></textarea>
            </div>
            <button type="submit" class="btn-save-mgmt" id="btn-save-entry">Save Changes</button>
          </div>

          <!-- Full 21 Parameters Overview -->
          <h4 class="section-divider">Profile Details</h4>
          <div class="detail-grid" id="drawer-details-content">
            <!-- Dynamically populated -->
          </div>

          <div class="drawer-danger-zone">
            <button type="button" class="btn-delete-entry" id="btn-delete-entry">
              🗑️ Delete This Participant Record
            </button>
          </div>
        </form>
      </div>
    </aside>

    <!-- 4. MANUAL CREATE MODAL -->
    <dialog id="create-modal" class="admin-modal">
      <div class="modal-card">
        <div class="modal-header">
          <h3>Record Offline Participant</h3>
          <button type="button" class="btn-close-modal" id="btn-close-create">✕</button>
        </div>
        <form id="create-entry-form" class="modal-form">
          <div class="form-grid-2">
            <div class="field-group">
              <label>FULL NAME *</label>
              <input type="text" id="create-name" required placeholder="e.g. Priya Patel" />
            </div>
            <div class="field-group">
              <label>EMAIL *</label>
              <input type="email" id="create-email" required placeholder="priya@example.com" />
            </div>
          </div>
          <div class="form-grid-2">
            <div class="field-group">
              <label>PHONE</label>
              <input type="tel" id="create-phone" placeholder="+91 98765 43210" />
            </div>
            <div class="field-group">
              <label>CITY / TOWN</label>
              <input type="text" id="create-city" placeholder="e.g. Bengaluru" />
            </div>
          </div>
          <div class="form-grid-2">
            <div class="field-group">
              <label>SKIN TONE DEPTH</label>
              <select id="create-depth">
                <option value="100 / Fair">100 / Fair</option>
                <option value="200 / Medium">200 / Medium</option>
                <option value="300 / Medium Deep" selected>300 / Medium Deep</option>
                <option value="400 / Deep">400 / Deep</option>
                <option value="I don't know">I don't know</option>
              </select>
            </div>
            <div class="field-group">
              <label>UNDERTONE</label>
              <select id="create-undertone">
                <option value="Warm (Golden, yellow, peachy)">Warm (Golden)</option>
                <option value="Cool (Rosy, pink, reddish)">Cool (Rosy)</option>
                <option value="Neutral (Balanced)">Neutral</option>
                <option value="Olive (Greenish-gold)">Olive</option>
                <option value="Unsure">Unsure</option>
              </select>
            </div>
          </div>
          <div class="field-group">
            <label>CURRENT BRAND & SHADE</label>
            <input type="text" id="create-brand" placeholder="e.g. MAC NC42, Maybelline 310" />
          </div>
          <div class="field-group">
            <label>INTERNAL NOTES</label>
            <textarea id="create-notes" rows="2" placeholder="Testing kit vials or in-person notes..."></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn-cancel" id="btn-cancel-create">Cancel</button>
            <button type="submit" class="btn-submit-create">Save Participant</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Floating Toast Notification -->
    <div id="toast" class="toast" style="display: none;"></div>
  </div>
</Layout>

<style>
  :root {
    --porcelain: #F5EFE8;
    --plum: #1B0516;
    --warm-white: #FCF9F5;
    --line: #DCD0D3;
    --muted: #6E5D68;
    --wine: #76022E;
    --wine-hover: #5D0224;
    --yellow: #F5C928;
    --purple: #7114AC;
    --sans: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    --serif: 'Cormorant Garamond', Georgia, serif;
    --mono: 'JetBrains Mono', monospace;
  }

  .admin-app {
    min-height: 100vh;
    background: #F9F6F0;
    font-family: var(--sans);
    color: var(--plum);
  }

  /* Topbar */
  .admin-topbar {
    background: var(--plum);
    color: #FFFFFF;
    padding: 16px 32px;
  }

  .topbar-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .admin-logo-img {
    height: 28px;
    width: auto;
    display: block;
  }

  .portal-badge {
    background: var(--wine);
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .topbar-user {
    display: flex;
    align-items: center;
    gap: 20px;
    font-size: 13px;
  }

  .btn-logout {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-logout:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #FFFFFF;
  }

  .spectrum-bar {
    height: 3px;
    background: linear-gradient(90deg, #76022E 0%, #7114AC 25%, #E40485 50%, #F5C928 75%, #00AEBD 100%);
  }

  /* Container */
  .admin-main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 64px;
  }

  /* Login Card */
  .view-login {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(80vh - 80px);
  }

  .login-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 40px 48px;
    width: 100%;
    max-width: 460px;
    box-shadow: 0 16px 48px rgba(27, 5, 22, 0.08);
  }

  .login-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--wine);
    margin-bottom: 6px;
  }

  .login-title {
    font-family: var(--serif);
    font-size: 28px;
    font-weight: 700;
    color: var(--plum);
    margin-bottom: 8px;
  }

  .login-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .login-alert {
    background: #FEECEB;
    border-left: 3px solid #D92D20;
    color: #912018;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 12px;
    margin-bottom: 16px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
  }

  .field-group label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--plum);
  }

  .field-group input,
  .field-group select {
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--plum);
    background: #FFFFFF;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field-group input:focus,
  .field-group select:focus {
    border-color: var(--wine);
    box-shadow: 0 0 0 3px rgba(118, 2, 46, 0.15);
  }

  .btn-primary-admin {
    width: 100%;
    height: 48px;
    background: var(--wine);
    color: #FFFFFF;
    border: none;
    border-radius: 9999px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 8px;
  }

  .btn-primary-admin:hover {
    background: var(--wine-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(118, 2, 46, 0.25);
  }

  .login-footer {
    text-align: center;
    font-size: 11px;
    color: var(--muted);
    margin-top: 24px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }

  /* Dashboard View */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 24px;
    box-shadow: 0 4px 12px rgba(27, 5, 22, 0.03);
  }

  .kpi-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .kpi-value {
    font-family: var(--serif);
    font-size: 36px;
    font-weight: 700;
    color: var(--plum);
    line-height: 1;
    margin-bottom: 6px;
  }

  .kpi-sub {
    font-size: 12px;
    color: var(--wine);
    font-weight: 600;
  }

  .kpi-spectrum-card {
    padding-bottom: 16px;
  }

  .depth-bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
  }

  .depth-bar-row {
    display: grid;
    grid-template-columns: 50px 1fr 20px;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }

  .progress-track {
    height: 6px;
    background: #EEE7DE;
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.5s ease;
  }

  .bar-fair { background: #E6BC98; }
  .bar-medium { background: #C58B58; }
  .bar-rich { background: #8E5632; }
  .bar-deep { background: #552F1D; }

  /* Controls Card */
  .controls-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 12px rgba(27, 5, 22, 0.03);
  }

  .search-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .search-wrap {
    position: relative;
    flex: 1;
    max-width: 500px;
  }

  .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    height: 42px;
    padding: 0 36px 0 38px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-family: var(--sans);
    font-size: 13px;
    outline: none;
    transition: all 0.2s ease;
  }

  .search-input:focus {
    border-color: var(--wine);
    box-shadow: 0 0 0 3px rgba(118, 2, 46, 0.12);
  }

  .btn-clear-search {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 12px;
    color: var(--muted);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-ctrl {
    height: 40px;
    padding: 0 16px;
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-add {
    background: var(--wine);
    color: #FFFFFF;
  }

  .btn-add:hover {
    background: var(--wine-hover);
  }

  .btn-export {
    background: #FFFFFF;
    border: 1px solid var(--line);
    color: var(--plum);
  }

  .btn-export:hover {
    background: var(--porcelain);
  }

  .btn-copy {
    background: #FFFFFF;
    border: 1px solid var(--line);
    color: var(--plum);
  }

  .btn-copy:hover {
    background: var(--porcelain);
  }

  /* Filters Row */
  .filters-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 14px;
    border-top: 1px solid #F0EAE1;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .filter-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .filter-pills {
    display: flex;
    gap: 6px;
  }

  .pill {
    background: #F4EFEB;
    border: 1px solid transparent;
    color: var(--plum);
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill.active {
    background: var(--wine);
    color: #FFFFFF;
  }

  .select-filter {
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 12px;
    background: #FFFFFF;
    color: var(--plum);
    outline: none;
  }

  .record-counter {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
  }

  /* Table Card */
  .table-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 4px 12px rgba(27, 5, 22, 0.03);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    text-align: left;
  }

  .data-table th {
    background: #FAF6F0;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  .data-table td {
    padding: 14px 18px;
    border-bottom: 1px solid #F2ECE4;
    color: #2F242C;
    vertical-align: middle;
  }

  .data-table tr:hover td {
    background: #FDFBF8;
  }

  .empty-cell {
    text-align: center;
    padding: 40px !important;
    color: var(--muted);
    font-size: 13px;
  }

  .id-pill {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--wine);
    background: rgba(118, 2, 46, 0.07);
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
  }

  .status-tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
  }

  .status-pending { background: #FEF3C7; color: #92400E; }
  .status-sent { background: #DBEAFE; color: #1E40AF; }
  .status-delivered { background: #D1FAE5; color: #065F46; }
  .status-archived { background: #F3F4F6; color: #4B5563; }

  .tone-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .tone-dot {
    width: 10px;
    height: 10px;
