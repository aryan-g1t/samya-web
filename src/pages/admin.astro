  }

  .btn-action:hover {
    background: var(--porcelain);
    border-color: var(--muted);
  }

  /* Slide-Out Detail Drawer */
  .drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(27, 5, 22, 0.45);
    backdrop-filter: blur(4px);
    z-index: 1000;
  }

  .detail-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(90vw, 560px);
    background: #FFFFFF;
    box-shadow: -16px 0 48px rgba(27, 5, 22, 0.25);
    z-index: 1001;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .detail-drawer.open {
    transform: translateX(0);
  }

  .drawer-header {
    padding: 24px 28px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .drawer-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--wine);
  }

  .drawer-title {
    font-family: var(--mono);
    font-size: 20px;
    color: var(--plum);
  }

  .btn-close-drawer {
    background: transparent;
    border: none;
    font-size: 18px;
    cursor: pointer;
    color: var(--muted);
  }

  .drawer-body {
    padding: 28px;
    overflow-y: auto;
    flex: 1;
  }

  .mgmt-box {
    background: #FAF6F0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .mgmt-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--wine);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mgmt-select,
  .mgmt-textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 13px;
    outline: none;
    background: #FFFFFF;
  }

  .btn-save-mgmt {
    margin-top: 12px;
    width: 100%;
    height: 40px;
    background: var(--wine);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  .section-divider {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 20px 0 12px;
    border-bottom: 1px solid #EFEAE2;
    padding-bottom: 6px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .detail-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    font-size: 12px;
    gap: 8px;
  }

  .detail-key {
    color: var(--muted);
    font-weight: 600;
  }

  .detail-val {
    color: var(--plum);
    font-weight: 500;
    word-break: break-word;
  }

  .drawer-danger-zone {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid #FEECEB;
  }

  .btn-delete-entry {
    width: 100%;
    padding: 12px;
    background: #FEECEB;
    border: 1px solid #FECDCA;
    color: #D92D20;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-delete-entry:hover {
    background: #FECDCA;
  }

  /* Create Modal */
  .admin-modal {
    padding: 0;
    border: none;
    border-radius: 16px;
    max-width: 540px;
    width: 90vw;
    box-shadow: 0 24px 64px rgba(27, 5, 22, 0.3);
    margin: auto;
  }

  .admin-modal::backdrop {
    background: rgba(27, 5, 22, 0.5);
    backdrop-filter: blur(4px);
  }

  .modal-card {
    padding: 28px;
    background: #FFFFFF;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .modal-header h3 {
    font-family: var(--serif);
    font-size: 22px;
    color: var(--plum);
  }

  .btn-close-modal {
    background: transparent;
    border: none;
    font-size: 16px;
    cursor: pointer;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 20px;
  }

  .btn-cancel {
    padding: 10px 18px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    cursor: pointer;
  }

  .btn-submit-create {
    padding: 10px 20px;
    background: var(--wine);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Toast Notification */
  .toast {
    position: fixed;
    bottom: 28px;
    right: 28px;
    background: var(--plum);
    color: #FFFFFF;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    z-index: 2000;
    animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes toastIn {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (max-width: 900px) {
    .kpi-grid {
      grid-template-columns: 1fr 1fr;
    }
    .search-row {
      flex-direction: column;
      align-items: stretch;
    }
    .search-wrap {
      max-width: none;
    }
    .action-buttons {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 600px) {
    .kpi-grid {
      grid-template-columns: 1fr;
    }
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Admin Console Client Controller
  let currentToken: string | null = null;
  let allEntries: any[] = [];
  let currentDetailParticipantId: string | null = null;

  function showToast(msg: string) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 3500);
  }

  function getDepthColor(depth: string) {
    const d = (depth || '').toLowerCase();
    if (d.includes('fair') || d.includes('100')) return '#E6BC98';
    if (d.includes('rich') || d.includes('300')) return '#8E5632';
    if (d.includes('deep') || d.includes('400')) return '#552F1D';
    return '#C58B58'; // medium
  }

  function escapeHtml(text: any) {
    if (text === null || text === undefined) return '';
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Check initial login state
  async function checkAuth() {
    try {
      const res = await fetch('/api/admin/login');
      const data = await res.json();
      if (data.authenticated) {
        showDashboard(data.user);
      } else {
        showLogin();
      }
    } catch {
      showLogin();
    }
  }

  function showLogin() {
    const loginView = document.getElementById('login-view');
    const dashView = document.getElementById('dashboard-view');
    const topUser = document.getElementById('topbar-user');
    if (loginView) loginView.style.display = 'flex';
    if (dashView) dashView.style.display = 'none';
    if (topUser) topUser.style.display = 'none';
  }

  function showDashboard(username: string) {
    const loginView = document.getElementById('login-view');
    const dashView = document.getElementById('dashboard-view');
    const topUser = document.getElementById('topbar-user');
    const userLabel = document.getElementById('current-username');

    if (loginView) loginView.style.display = 'none';
    if (dashView) dashView.style.display = 'block';
    if (topUser) topUser.style.display = 'flex';
    if (userLabel) userLabel.textContent = username;

    fetchEntries();
  }

  // Fetch entries & KPIs
  async function fetchEntries() {
    const searchInput = (document.getElementById('filter-search') as HTMLInputElement)?.value || '';
    const activeDepth = document.querySelector('#depth-pills .pill.active')?.getAttribute('data-depth') || 'all';
    const kitSelect = (document.getElementById('filter-kit') as HTMLSelectElement)?.value || 'all';
    const compSelect = (document.getElementById('filter-completion') as HTMLSelectElement)?.value || 'all';

    const params = new URLSearchParams({
      search: searchInput,
      depth: activeDepth,
      kitStatus: kitSelect,
      completion: compSelect
    });

    const headers: Record<string, string> = {};
    if (currentToken) headers['X-Admin-Token'] = currentToken;

    try {
      const res = await fetch(`/api/admin/entries?${params.toString()}`, { headers });
      if (res.status === 401) {
        showLogin();
        return;
      }

      const data = await res.json();
      allEntries = data.entries || [];

      // Update KPI Cards
      const stats = data.stats || {};
      const total = stats.total || 0;
      const full = stats.fullProfiles || 0;
      const rate = total > 0 ? Math.round((full / total) * 100) : 0;

      const kpiTotal = document.getElementById('kpi-total');
      const kpiFull = document.getElementById('kpi-full');
      const kpiCompRate = document.getElementById('kpi-completion-rate');
      const kpiCandidates = document.getElementById('kpi-candidates');
      const recFiltered = document.getElementById('record-filtered-count');
      const recTotal = document.getElementById('record-total-count');

      if (kpiTotal) kpiTotal.textContent = total.toString();
      if (kpiFull) kpiFull.textContent = full.toString();
      if (kpiCompRate) kpiCompRate.textContent = `${rate}% completion rate`;
      if (kpiCandidates) kpiCandidates.textContent = (stats.kitCandidates || 0).toString();
      if (recFiltered) recFiltered.textContent = (data.filteredCount || 0).toString();
      if (recTotal) recTotal.textContent = total.toString();

      // Update Depth Bars
      const dist = stats.depthDistribution || {};
      const maxVal = Math.max(dist.fair || 0, dist.medium || 0, dist.rich || 0, dist.deep || 0, 1);

      updateBar('fair', dist.fair || 0, maxVal);
      updateBar('medium', dist.medium || 0, maxVal);
      updateBar('rich', dist.rich || 0, maxVal);
      updateBar('deep', dist.deep || 0, maxVal);

      // Render Table
      renderTable(allEntries);

    } catch (err) {
      console.error('Failed to fetch admin entries:', err);
    }
  }

  function updateBar(key: string, count: number, max: number) {
    const bar = document.getElementById(`depth-bar-${key}`);
    const label = document.getElementById(`depth-count-${key}`);
    if (bar) bar.style.width = `${Math.round((count / max) * 100)}%`;
    if (label) label.textContent = count.toString();
  }

  // Render Table Rows
  function renderTable(entries: any[]) {
    const tbody = document.getElementById('table-body');
    if (!tbody) return;

    if (entries.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8" class="empty-cell">No participant records matching current filters.</td></tr>`;
      return;
    }

    tbody.innerHTML = entries.map(item => {
      const kitStatus = item.kitStatus || (item.sampleTestingConsent?.toLowerCase().includes('yes') ? 'Pending' : 'Archived');
      const statusClass = `status-${kitStatus.toLowerCase().replace(/\s+/g, '-')}`;
      const depthColor = getDepthColor(item.skinToneDepth);

      return `
        <tr>
          <td><span class="id-pill">${escapeHtml(item.participantId)}</span></td>
          <td><strong>${escapeHtml(item.fullName || 'Anonymous')}</strong></td>
          <td>
            <div>${escapeHtml(item.email || '—')}</div>
            <div style="font-size: 11px; color: var(--muted);">${escapeHtml(item.phone || '')}</div>
          </td>
          <td>${escapeHtml(item.city || item.state || '—')}</td>
          <td>
            <div class="tone-badge">
              <span class="tone-dot" style="background-color: ${depthColor};"></span>
              <span>${escapeHtml(item.skinToneDepth || 'Unknown')}</span>
            </div>
            <div style="font-size: 10px; color: var(--muted); margin-top: 2px;">${escapeHtml(item.undertone || '')}</div>
          </td>
          <td>
            <span style="font-size: 11px; font-weight: 600; color: ${item.stageCompleted === 'Full Profile' ? 'var(--wine)' : 'var(--muted)'};">
              ${escapeHtml(item.stageCompleted || 'Initial')}
            </span>
          </td>
          <td>
            <span class="status-tag ${statusClass}">${escapeHtml(kitStatus)}</span>
          </td>
          <td>
            <div class="actions-group">
              <button type="button" class="btn-action btn-view" data-id="${escapeHtml(item.participantId)}">👁️ View</button>
              <button type="button" class="btn-action btn-del" data-id="${escapeHtml(item.participantId)}" style="color: #D92D20;">🗑️</button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    // Attach row action listeners
    tbody.querySelectorAll('.btn-view').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) openDetailDrawer(id);
      });
    });

    tbody.querySelectorAll('.btn-del').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) confirmDeleteEntry(id);
      });
    });
  }

  // Open Drawer
  function openDetailDrawer(participantId: string) {
    const entry = allEntries.find(e => e.participantId === participantId);
    if (!entry) return;

    currentDetailParticipantId = participantId;

    const drawer = document.getElementById('detail-drawer');
    const overlay = document.getElementById('drawer-overlay');
    const title = document.getElementById('drawer-participant-id');
    const statusSelect = document.getElementById('edit-kit-status') as HTMLSelectElement | null;
    const notesText = document.getElementById('edit-internal-notes') as HTMLTextAreaElement | null;
    const detailsContainer = document.getElementById('drawer-details-content');

    if (title) title.textContent = participantId;
    if (statusSelect) statusSelect.value = entry.kitStatus || 'Pending';
    if (notesText) notesText.value = entry.internalNotes || '';

    if (detailsContainer) {
      const fields = [
        ['Timestamp', entry.timestamp || '—'],
        ['Full Name', entry.fullName || '—'],
        ['Email Address', entry.email || '—'],
        ['Phone Number', entry.phone || '—'],
        ['State / Region', entry.state || '—'],
        ['City / Town', entry.city || '—'],
        ['Skin Tone Depth', entry.skinToneDepth || '—'],
        ['Undertone', entry.undertone || '—'],
        ['Current Brand / Shade', entry.currentBrandAndShade || '—'],
        ['Neck vs Face Match', entry.neckVsFace || '—'],
        ['Past Experience', entry.pastExperience || '—'],
        ['Biggest Challenges', entry.biggestChallenges || '—'],
        ['Match Priorities', entry.simplifiedMatchNeeds || '—'],
        ['Seasonal Shift', entry.seasonalShift || '—'],
        ['Testing Kit Consent', entry.sampleTestingConsent || '—'],
        ['Selection Confidence', entry.selectionConfidence || '—'],
        ['Current Skin Status', entry.skinStatusNow || '—'],
        ['Opt-in Updates', entry.optInUpdates || '—']
      ];

      detailsContainer.innerHTML = fields.map(([key, val]) => `
        <div class="detail-row">
          <span class="detail-key">${key}:</span>
          <span class="detail-val">${escapeHtml(val)}</span>
        </div>
      `).join('');
    }

    drawer?.classList.add('open');
    if (overlay) overlay.style.display = 'block';
  }

  function closeDetailDrawer() {
    const drawer = document.getElementById('detail-drawer');
    const overlay = document.getElementById('drawer-overlay');
    drawer?.classList.remove('open');
    if (overlay) overlay.style.display = 'none';
    currentDetailParticipantId = null;
  }

  // Delete Entry
  async function confirmDeleteEntry(participantId: string) {
    if (!confirm(`Are you sure you want to delete participant ${participantId}? This action cannot be undone.`)) {
      return;
    }

    try {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (currentToken) headers['X-Admin-Token'] = currentToken;

      const res = await fetch('/api/admin/entry', {
        method: 'DELETE',
        headers,
        body: JSON.stringify({ participantId })
      });

      if (res.ok) {
        showToast(`Record ${participantId} deleted`);
        closeDetailDrawer();
        fetchEntries();
      } else {
        alert('Failed to delete entry');
      }
    } catch {
      alert('Error during deletion');
    }
  }

  // Export CSV
  function exportFilteredCsv() {
    if (allEntries.length === 0) {
      alert('No records to export');
      return;
    }

    const headers = [
      'Timestamp', 'Participant ID', 'Full Name', 'Email', 'Phone', 'City', 'State',
      'Skin Tone Depth', 'Undertone', 'Stage', 'Kit Status', 'Brand Used', 'Testing Consent'
    ];

    const rows = [headers.join(',')];

    for (const r of allEntries) {
      const row = [
        r.timestamp, r.participantId, r.fullName, r.email, r.phone, r.city, r.state,
        r.skinToneDepth, r.undertone, r.stageCompleted, r.kitStatus || 'Pending',
        r.currentBrandAndShade, r.sampleTestingConsent
      ].map(val => `"${String(val || '').replace(/"/g, '""')}"`);

      rows.push(row.join(','));
    }

    const blob = new Blob([rows.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `samya_export_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    showToast(`Exported ${allEntries.length} records`);
  }

  // Copy Emails
  function copyFilteredEmails() {
    const emails = allEntries.map(e => e.email?.trim()).filter(Boolean);
    if (emails.length === 0) {
      alert('No email addresses found in current filter');
      return;
    }
    const emailList = Array.from(new Set(emails)).join(', ');
    navigator.clipboard.writeText(emailList);
    showToast(`Copied ${emails.length} email addresses to clipboard!`);
  }

  // Event Listeners setup
  document.addEventListener('DOMContentLoaded', () => {
    checkAuth();

    // Login Form Submit
    const loginForm = document.getElementById('login-form');
    loginForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const usernameInput = (document.getElementById('username') as HTMLInputElement)?.value;
      const passwordInput = (document.getElementById('password') as HTMLInputElement)?.value;
      const errBox = document.getElementById('login-error');

      if (errBox) errBox.style.display = 'none';

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: usernameInput, password: passwordInput })
        });

        const data = await res.json();
        if (res.ok && data.status === 'success') {
          if (data.token) currentToken = data.token;
          showDashboard(data.user);
        } else {
          if (errBox) {
            errBox.textContent = data.error || 'Authentication failed';
            errBox.style.display = 'block';
          }
        }
      } catch {
        if (errBox) {
          errBox.textContent = 'Connection error. Please try again.';
          errBox.style.display = 'block';
        }
      }
    });

    // Logout
    document.getElementById('btn-logout')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      currentToken = null;
      showLogin();
    });

    // Search input (debounce)
    let searchTimeout: any = null;
    const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('btn-clear-search');

    searchInput?.addEventListener('input', () => {
      if (clearSearchBtn) clearSearchBtn.style.display = searchInput.value ? 'block' : 'none';
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(fetchEntries, 300);
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (clearSearchBtn) clearSearchBtn.style.display = 'none';
      fetchEntries();
    });

    // Depth Pills
    document.querySelectorAll('#depth-pills .pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('#depth-pills .pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        fetchEntries();
      });
    });

    // Select filters
    document.getElementById('filter-kit')?.addEventListener('change', fetchEntries);
    document.getElementById('filter-completion')?.addEventListener('change', fetchEntries);

    // Export & Copy
    document.getElementById('btn-export-csv')?.addEventListener('click', exportFilteredCsv);
    document.getElementById('btn-copy-emails')?.addEventListener('click', copyFilteredEmails);

    // Drawer close
    document.getElementById('btn-close-drawer')?.addEventListener('click', closeDetailDrawer);
    document.getElementById('drawer-overlay')?.addEventListener('click', closeDetailDrawer);

    // Save changes in drawer
    document.getElementById('edit-entry-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentDetailParticipantId) return;

      const kitStatus = (document.getElementById('edit-kit-status') as HTMLSelectElement)?.value;
      const internalNotes = (document.getElementById('edit-internal-notes') as HTMLTextAreaElement)?.value;

      try {
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (currentToken) headers['X-Admin-Token'] = currentToken;

        const res = await fetch('/api/admin/entry', {
          method: 'PUT',
          headers,
          body: JSON.stringify({
            participantId: currentDetailParticipantId,
            updates: { kitStatus, internalNotes }
          })
        });

        if (res.ok) {
          showToast('Participant status updated successfully');
          fetchEntries();
        } else {
          alert('Failed to update participant');
        }
      } catch {
        alert('Network error while saving updates');
      }
    });

    // Drawer Delete button
    document.getElementById('btn-delete-entry')?.addEventListener('click', () => {
      if (currentDetailParticipantId) confirmDeleteEntry(currentDetailParticipantId);
    });

    // Create Modal
    const createModal = document.getElementById('create-modal') as HTMLDialogElement | null;
    document.getElementById('btn-open-create')?.addEventListener('click', () => createModal?.showModal());
    document.getElementById('btn-close-create')?.addEventListener('click', () => createModal?.close());
    document.getElementById('btn-cancel-create')?.addEventListener('click', () => createModal?.close());

    // Submit Create Form
    document.getElementById('create-entry-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const payload = {
        fullName: (document.getElementById('create-name') as HTMLInputElement)?.value,
        email: (document.getElementById('create-email') as HTMLInputElement)?.value,
        phone: (document.getElementById('create-phone') as HTMLInputElement)?.value,
        city: (document.getElementById('create-city') as HTMLInputElement)?.value,
        skinToneDepth: (document.getElementById('create-depth') as HTMLSelectElement)?.value,
        undertone: (document.getElementById('create-undertone') as HTMLSelectElement)?.value,
        currentBrandAndShade: (document.getElementById('create-brand') as HTMLInputElement)?.value,
        internalNotes: (document.getElementById('create-notes') as HTMLTextAreaElement)?.value,
        kitStatus: 'Pending',
        sampleTestingConsent: 'Yes',
        stageCompleted: 'Full Profile'
      };

      try {
        const headers: Record<string, string> = { 'Content-Type': 'application/json' };
        if (currentToken) headers['X-Admin-Token'] = currentToken;

        const res = await fetch('/api/admin/entry', {
          method: 'POST',
          headers,
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          showToast('Offline participant recorded successfully!');
          createModal?.close();
          (document.getElementById('create-entry-form') as HTMLFormElement)?.reset();
          fetchEntries();
        } else {
          alert('Failed to create participant record');
        }
      } catch {
        alert('Error creating participant');
      }
    });
  });
</script>

