---
// Footer.astro - Master Wine multi-column editorial footer
---

<footer class="site-footer" aria-label="Site footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Col 1: Newsletter & Tagline -->
      <div class="footer-col-1">
        <h3 class="col-title">LET'S STAY IN TOUCH</h3>
        <form class="newsletter-form" id="footer-newsletter-form">
          <input
            type="email"
            class="newsletter-input"
            placeholder="Your Email"
            required
            aria-label="Your email address"
          />
          <button type="submit" class="newsletter-btn" aria-label="Submit email">
            SUBMIT
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
        </form>
        <p class="tagline">
          Real Skin. Real Stories.<br />A More Inclusive Tomorrow.
        </p>
      </div>

      <!-- Col 2: Contact & Socials -->
      <div class="footer-col-2">
        <div class="contact-block">
          <h4 class="sub-title">CONTACT US</h4>
          <a href="tel:+15519981150" class="contact-link">+1 (551) 998-1150</a>
          <a href="mailto:hello@samyaglobal.com" class="contact-link">hello@samyaglobal.com</a>
        </div>

        <div class="social-block">
          <h4 class="sub-title">FOLLOW US</h4>
          <div class="social-icons" aria-label="Social media links">
            <!-- Instagram -->
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
            <!-- Facebook -->
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
            <!-- LinkedIn -->
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
            <!-- X / Twitter -->
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="social-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 3: Referral & Brand Logo -->
      <div class="footer-col-3">
        <a href="#join" class="referral-card" data-open-modal>
          <span class="referral-text">
            Know someone who'd love to help? Share the survey with friends.
          </span>
          <span class="referral-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </a>

        <div class="brand-stacked-wrap">
          <img
            src="/images/logo-white-stacked.png"
            alt="Sāmya:"
            class="brand-stacked-img"
            width="170"
            height="140"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="legal-bar">
      <div class="legal-spectrum" aria-hidden="true"></div>
      <div class="legal-row">
        <span>HEADQUARTERED IN NEW YORK. BEGINNING IN INDIA.</span>
        <span>© 2026 Sāmya. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--wine);
    color: #FFFFFF;
    border-radius: 40px 40px 0 0;
    padding: 72px 0 36px;
    position: relative;
    overflow: hidden;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 56px;
    margin-bottom: 56px;
    align-items: flex-start;
  }

  .col-title {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 20px;
  }

  .newsletter-form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    border: 1px solid #D4AF37;
    border-radius: 9999px;
    padding: 4px 6px 4px 22px;
    max-width: 360px;
    margin-bottom: 32px;
    background: rgba(0, 0, 0, 0.1);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .newsletter-form:focus-within {
    border-color: #FFFFFF;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.3);
  }

  .newsletter-input {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-family: var(--sans);
    font-size: 13px;
    width: 100%;
    outline: none;
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.65);
  }

  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 16px;
    border-radius: 9999px;
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .newsletter-btn:hover {
    opacity: 0.9;
    transform: translateX(2px);
  }

  .btn-arrow {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #FFFFFF;
    color: var(--wine);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
  }

  .tagline {
    font-family: var(--serif);
    font-style: italic;
    font-size: 26px;
    line-height: 1.25;
    color: var(--yellow);
    margin: 0;
  }

  .sub-title {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.9);
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .contact-block {
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-link {
    font-family: var(--sans);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .social-icons {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .social-icon {
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .social-icon:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  .footer-col-3 {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 36px;
  }

  .referral-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 18px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    text-decoration: none;
    max-width: 280px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .referral-card:hover {
    background: rgba(255, 255, 255, 0.14);
    transform: translateY(-2px);
  }

  .referral-text {
    font-family: var(--sans);
    font-size: 11px;
    line-height: 1.45;
    color: #FFFFFF;
  }

  .referral-arrow {
    width: 24px;
    height: 24px;
    background: #FFFFFF;
    color: var(--wine);
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-stacked-wrap {
    display: flex;
    justify-content: flex-end;
  }

  .brand-stacked-img {
    height: 110px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* Bottom Legal */
  .legal-bar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .legal-spectrum {
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--turquoise) 0%, var(--yellow) 30%, var(--fuchsia) 60%, var(--purple) 100%);
    opacity: 0.5;
  }

  .legal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .footer-col-3 {
      align-items: flex-start;
    }
    .legal-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  @media (max-width: 540px) {
    .site-footer {
      border-radius: 28px 28px 0 0;
      padding: 48px 0 28px;
    }
    .tagline {
      font-size: 22px;
    }
  }
</style>

<script>
  const form = document.getElementById('footer-newsletter-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for subscribing to Sāmya updates.');
    });
  }
</script>
