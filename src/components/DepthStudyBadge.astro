---
// DepthStudyBadge.astro - Floating foundation depth spectrum card
const swatches = [
  { name: 'Very Light', color: '#F2E4D4' },
  { name: 'Light', color: '#E2C3A7' },
  { name: 'Light-Medium', color: '#CE9F7B' },
  { name: 'Medium-Tan', color: '#B67E55' },
  { name: 'Caramel', color: '#97603B' },
  { name: 'Deep Bronze', color: '#693E22' },
  { name: 'Rich Espresso', color: '#3E2316' }
];
---

<div class="depth-study-card" id="depthStudyCard" aria-label="The Depth Study: 7 skin depth swatches from very light to rich espresso">
  <span class="depth-title">THE DEPTH STUDY</span>
  <div class="swatch-row">
    {swatches.map((s, idx) => (
      <span
        class="swatch-capsule"
        style={`--swatch-color: ${s.color}; --delay: ${idx * 40}ms;`}
        title={s.name}
        aria-label={s.name}
      />
    ))}
  </div>
</div>

<style>
  .depth-study-card {
    position: absolute;
    right: -24px;
    bottom: 24px;
    background: #FFFFFF;
    border-radius: 20px;
    padding: 16px 20px;
    box-shadow: 0 16px 40px rgba(27, 5, 22, 0.14), 0 2px 6px rgba(27, 5, 22, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 4;
    transform: translateZ(30px);
    will-change: transform;
    animation: floatingPill 4s ease-in-out infinite alternate;
    user-select: none;
    pointer-events: auto;
  }

  @keyframes floatingPill {
    0% {
      transform: translateZ(30px) translateY(0);
    }
    100% {
      transform: translateZ(30px) translateY(-6px);
    }
  }

  .depth-title {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--plum);
    text-transform: uppercase;
  }

  .swatch-row {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .swatch-capsule {
    width: 16px;
    height: 38px;
    border-radius: 9999px;
    background-color: var(--swatch-color);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.4), 0 2px 4px rgba(27, 5, 22, 0.08);
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s ease;
    cursor: pointer;
  }

  .swatch-capsule:hover {
    transform: translateY(-4px) scale(1.1);
    box-shadow: 0 8px 16px rgba(27, 5, 22, 0.18);
  }

  @media (max-width: 800px) {
    .depth-study-card {
      right: 12px;
      bottom: -24px;
      padding: 12px 16px;
      gap: 10px;
      border-radius: 16px;
    }
    .depth-title {
      font-size: 10px;
    }
    .swatch-capsule {
      width: 14px;
      height: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .depth-study-card {
      animation: none;
    }
    .swatch-capsule {
      transition: none;
    }
  }
</style>

