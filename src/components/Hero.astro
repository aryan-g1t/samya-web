---
// Hero.astro - Master hero section with dual-portrait arched card & Depth Study badge
import DepthStudyBadge from './DepthStudyBadge.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow" data-animate="fade-up">A NEW APPROACH TO COMPLEXION</p>
      <h1 id="hero-title" data-animate="fade-up" data-delay="100">
        Finding your foundation shade shouldn't be <em>this complicated.</em>
      </h1>
      <p class="lead" data-animate="fade-up" data-delay="200">
        Too few shades to choose from. Limited opportunities to test them. And even when a shade looks right, it doesn't always wear the way you expect.
      </p>
      <p class="secondary" data-animate="fade-up" data-delay="300">
        We're building a better approach to complexion products, starting with India's diverse skin tones.
      </p>
      <div class="action-row" data-animate="fade-up" data-delay="400">
        <button class="btn btn-primary" type="button" data-open-modal>
          Help us build it
        </button>
        <a class="text-link" href="#the-problem">EXPLORE OUR APPROACH</a>
      </div>
      <p class="hero-meta" data-animate="fade-up" data-delay="500">
        <i class="meta-dot" aria-hidden="true"></i> FOUNDING RESEARCH <span aria-hidden="true">—</span> INDIA FIRST
      </p>
    </div>

    <div class="art-column" data-animate="fade-up" data-delay="200">
      <div class="art-wrap" id="hero-art-wrap">
        <div 
          class="hero-art" 
          id="hero-art-card"
          role="img" 
          aria-label="Editorial beauty portrait of two Indian women with diverse skin tones testing real foundation shade swatches on their skin"
        >
          <img
            src="/images/hero-portrait.webp"
            alt="Two Indian women testing foundation swatches on their complexions"
            class="art-photo"
            width="510"
            height="600"
            loading="eager"
            decoding="async"
          />
          <div class="art-sheen" id="hero-art-sheen" aria-hidden="true"></div>
          <DepthStudyBadge />
        </div>
      </div>
      <div class="art-caption">
        <div class="dots-spectrum" aria-hidden="true">
          <i class="dot-purple"></i>
          <i class="dot-fuchsia"></i>
          <div class="spectrum-bar"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 65px 0 83px;
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(48px, 5vw, 98px);
    align-items: center;
  }

  .eyebrow {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--wine);
    text-transform: uppercase;
    margin: 0;
  }

  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(56px, 5.8vw, 84px);
    letter-spacing: -0.04em;
    line-height: 1.04;
    margin: 28px 0 24px;
    max-width: 680px;
    color: var(--plum);
  }

  .hero h1 em {
    font-weight: 400;
    color: var(--wine);
    font-style: italic;
    position: relative;
    display: inline-block;
  }

  .hero .lead {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.75;
    max-width: 500px;
    color: var(--ink-body);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }

  .hero .secondary {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    max-width: 480px;
    color: var(--muted);
    margin: 0 0 36px;
  }

  .action-row {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 32px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    border-radius: 9999px;
    background: var(--wine);
    color: #FFFFFF;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(118, 2, 46, 0.2);
    transition: transform 0.25s var(--ease-spring), background-color 0.2s ease, box-shadow 0.25s ease;
    will-change: transform;
  }

  .btn-primary:hover {
    background: #5d0224;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(118, 2, 46, 0.32);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .text-link {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--plum);
    text-decoration: none;
    position: relative;
    padding: 6px 0;
    transition: color 0.2s ease;
  }

  .text-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--wine);
    transition: width 0.25s var(--ease-out-expo);
  }

  .text-link:hover {
    color: var(--wine);
  }

  .text-link:hover::after {
    width: 100%;
  }

  .hero-meta {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--wine);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--wine);
    display: inline-block;
  }

  /* Right column: Arch art card */
  .art-column {
    position: relative;
    width: 100%;
    max-width: 530px;
    margin-inline: auto;
  }

  .art-wrap {
    position: relative;
    perspective: 1200px;
    transform-style: preserve-3d;
  }

  .hero-art {
    position: relative;
    width: 100%;
    height: clamp(490px, 41vw, 610px);
    border-radius: 255px 255px 20px 20px;
    overflow: visible;
    background: #E8DDD2;
    box-shadow: 0 24px 60px rgba(27, 5, 22, 0.12);
    transform: rotateX(0deg) rotateY(0deg);
    transition: box-shadow 0.3s ease;
    will-change: transform;
  }

  .art-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    border-radius: 255px 255px 20px 20px;
    user-select: none;
    -webkit-user-drag: none;
  }

  .art-sheen {
    position: absolute;
    inset: 0;
    border-radius: 255px 255px 20px 20px;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.28) 0%, transparent 60%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    mix-blend-mode: overlay;
    z-index: 2;
  }

  /* Bottom Dots & Spectrum line */
  .art-caption {
    margin-top: 24px;
    display: flex;
    align-items: center;
  }

  .dots-spectrum {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dot-purple {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--purple);
    display: inline-block;
  }

  .dot-fuchsia {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--fuchsia);
    display: inline-block;
  }

  .spectrum-bar {
    width: 110px;
    height: 5px;
    border-radius: 9999px;
    background: linear-gradient(90deg, var(--purple) 0%, var(--fuchsia) 35%, var(--yellow) 70%, var(--turquoise) 100%);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .art-column {
      max-width: 440px;
    }
    .hero-art {
      height: 520px;
    }
  }

  @media (max-width: 540px) {
    .hero {
      padding: 40px 0 60px;
    }
    .hero h1 {
      font-size: 44px;
      margin: 20px 0 18px;
    }
    .action-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
    .art-column {
      max-width: 320px;
    }
    .hero-art {
      height: 400px;
      border-radius: 190px 190px 16px 16px;
    }
    .art-photo {
      border-radius: 190px 190px 16px 16px;
    }
  }
</style>
