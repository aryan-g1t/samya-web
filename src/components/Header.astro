---
// Header.astro - Master navigation with official Sāmya: lockup
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="#top" aria-label="Sāmya: home">
      <img
        src="/images/logo-dark.png"
        alt="Sāmya:"
        class="logo-img"
        width="148"
        height="38"
        loading="eager"
        decoding="async"
      />
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="#the-problem" class="nav-link">THE PROBLEM</a>
      <a href="#our-method" class="nav-link">OUR APPROACH</a>
      <button class="nav-join" type="button" data-open-modal aria-haspopup="dialog">
        JOIN OUR RESEARCH
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--porcelain);
    position: relative;
    z-index: 20;
  }

  .header-inner {
    height: 94px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    transition: opacity 0.2s ease, transform 0.2s var(--ease-spring);
  }

  .logo:hover {
    opacity: 0.88;
    transform: scale(1.02);
  }

  .logo-img {
    height: 38px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav-link {
    text-decoration: none;
    text-transform: uppercase;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--plum);
    white-space: nowrap;
    transition: color 0.2s ease;
    position: relative;
    padding: 6px 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--purple);
    transition: width 0.25s var(--ease-out-expo);
  }

  .nav-link:hover {
    color: var(--purple);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-join {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 24px;
    border-radius: 9999px;
    border: 1px solid var(--plum);
    background: transparent;
    color: var(--plum);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.12em;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s var(--ease-out-expo), box-shadow 0.25s ease;
    will-change: transform;
  }

  .nav-join:hover {
    background: var(--plum);
    color: var(--porcelain);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(27, 5, 22, 0.14);
  }

  .nav-join:active {
    transform: translateY(0);
  }

  @media (max-width: 800px) {
    .header-inner {
      height: 76px;
    }
    .logo-img {
      height: 32px;
    }
    .site-nav {
      gap: 16px;
    }
    .nav-link {
      display: none;
    }
    .nav-join {
      height: 38px;
      padding: 0 16px;
      font-size: 10px;
    }
  }
</style>
