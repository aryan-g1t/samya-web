<script>
  // Reactive Survey Navigation Controller
  function initSurveyController() {
    const dialog = document.getElementById('research-modal') as HTMLDialogElement | null;
    if (!dialog) return;

    const wrapper = dialog.querySelector('.dialog-wrapper');
    const dialogBody = document.getElementById('dialogBody');
    const phaseBadge = document.getElementById('modalPhaseBadge');
    const progressTrack = document.getElementById('progressTrack');
    const progressFill = document.getElementById('progressFill');
    const modalLogo = document.getElementById('modalLogo') as HTMLImageElement | null;
    const screens = Array.from(dialog.querySelectorAll<HTMLElement>('.survey-screen'));

    let currentScreen = 1;

    function goToScreen(target: number) {
      if (target < 1 || target > 18) return;

      screens.forEach(s => {
        const sNum = parseInt(s.dataset.screen || '1', 10);
        if (sNum === target) {
          s.hidden = false;
          s.classList.add('active');
        } else {
          s.hidden = true;
          s.classList.remove('active');
        }
      });

      currentScreen = target;
      if (dialog) dialog.dataset.activeScreen = currentScreen.toString();
      if (dialogBody) dialogBody.scrollTop = 0;

      // Update Header & Styling Modes
      if (target === 10) {
        wrapper?.classList.add('is-wine');
        if (modalLogo) modalLogo.src = '/images/logo-white.png';
        if (phaseBadge) phaseBadge.textContent = 'INVITATION';
        if (progressTrack) progressTrack.hidden = true;
      } else {
        wrapper?.classList.remove('is-wine');
        if (modalLogo) modalLogo.src = '/images/logo-dark.png';

        if (target === 1) {
          if (phaseBadge) phaseBadge.textContent = 'THE JOURNEY';
          if (progressTrack) progressTrack.hidden = true;
        } else if (target === 2) {
          if (phaseBadge) phaseBadge.textContent = 'REGISTRATION';
          if (progressTrack) progressTrack.hidden = true;
        } else if (target >= 3 && target <= 9) {
          const stepIdx = target - 2;
          if (phaseBadge) phaseBadge.textContent = `SURVEY | 0${stepIdx}/07`;
          if (progressTrack) progressTrack.hidden = false;
          if (progressFill) progressFill.style.width = `${(stepIdx / 7) * 100}%`;
        } else if (target >= 11 && target <= 17) {
          const profileIdx = target - 10;
          if (phaseBadge) phaseBadge.textContent = `SHADE PROFILE | 0${profileIdx}/07`;
          if (progressTrack) progressTrack.hidden = false;
          if (progressFill) progressFill.style.width = `${(profileIdx / 7) * 100}%`;
        } else if (target === 18) {
          if (phaseBadge) phaseBadge.textContent = 'COMPLETE';
          if (progressTrack) progressTrack.hidden = true;
        }
      }
    }

    // Centralized Survey Response Collector & Webhook Dispatcher
    const surveyState: Record<string, any> = {
      participantId: 'SAM-' + Math.floor(100000 + Math.random() * 900000),
      timestamp: new Date().toISOString(),
      biggestChallenges: ['The shade looks different after wearing it.'],
      simplifiedMatchNeeds: ['Testing at home in natural light'],
      skinToneDepth: '300 / Medium Deep'
    };

    function collectCurrentState(stageCompleted: 'Full Profile' | 'Initial Experience') {
      surveyState.fullName = (document.getElementById('fullName') as HTMLInputElement)?.value || '';
      surveyState.email = (document.getElementById('userEmail') as HTMLInputElement)?.value || '';
      surveyState.phone = (document.getElementById('userPhone') as HTMLInputElement)?.value || '';
      surveyState.optInUpdates = (document.getElementById('emailOptIn') as HTMLInputElement)?.checked ?? true;

      // Screen 3: State
      surveyState.state = (document.getElementById('stateSelect') as HTMLSelectElement)?.value || '';

      // Screen 4: Past Experience
      const pastExp = dialog?.querySelector<HTMLInputElement>('input[name="pastExp"]:checked');
      if (pastExp) surveyState.pastExperience = pastExp.value;

      // Screen 5: Chips
      const screen5Chips = Array.from(dialog?.querySelectorAll<HTMLElement>('[data-screen="5"] .chip.active') || []).map(c => c.textContent?.trim() || '');
      if (screen5Chips.length) surveyState.biggestChallenges = screen5Chips;

      // Screen 6: Depth
      const selectedDepth = dialog?.querySelector<HTMLElement>('.depth-tile.selected');
      if (selectedDepth) surveyState.skinToneDepth = selectedDepth.dataset.tone || '';

      // Screen 7: Undertone
      const undertone = dialog?.querySelector<HTMLInputElement>('input[name="undertone"]:checked');
      if (undertone) surveyState.undertone = undertone.value;

      // Screen 8: Seasonal Shift
      const seasonal = dialog?.querySelector<HTMLInputElement>('input[name="seasonalShift"]:checked');
      if (seasonal) surveyState.seasonalShift = seasonal.value;

      // Screen 9: Testing Interest
      const testingInt = dialog?.querySelector<HTMLInputElement>('input[name="testingInterest"]:checked');
      if (testingInt) surveyState.testingInterest = testingInt.value;

      surveyState.stageCompleted = stageCompleted;

      if (stageCompleted === 'Full Profile') {
        // Screen 11: Current brand
        surveyState.currentBrandAndShade = (document.getElementById('currentBrand') as HTMLInputElement)?.value || '';

        // Screen 12: Neck comparison
        const neck = dialog?.querySelector<HTMLInputElement>('input[name="neckComp"]:checked');
        if (neck) surveyState.neckVsFace = neck.value;

        // Screen 13: Simplified match needs chips
        const screen13Chips = Array.from(dialog?.querySelectorAll<HTMLElement>('[data-screen="13"] .chip.active') || []).map(c => c.textContent?.trim() || '');
        if (screen13Chips.length) surveyState.simplifiedMatchNeeds = screen13Chips;

        // Screen 14: Skin status now
        const skinNow = dialog?.querySelector<HTMLInputElement>('input[name="skinNow"]:checked');
        if (skinNow) surveyState.skinStatusNow = skinNow.value;

        // Screen 15: Selection confidence
        const conf = dialog?.querySelector<HTMLInputElement>('input[name="confidence"]:checked');
        if (conf) surveyState.selectionConfidence = conf.value;

        // Screen 16: City
        surveyState.city = (document.getElementById('cityName') as HTMLInputElement)?.value || '';

        // Screen 17: Sample consent
        const consent = dialog?.querySelector<HTMLInputElement>('input[name="sampleConsent"]:checked');
        if (consent) surveyState.sampleTestingConsent = consent.value;
      }

      return surveyState;
    }

    async function submitSurveyData(stage: 'Full Profile' | 'Initial Experience') {
      const payload = collectCurrentState(stage);
      
      // Update Screen 18 badge
      const badge = document.getElementById('participantIdBadge');
      if (badge) badge.textContent = `PARTICIPANT ID · ${payload.participantId}`;

      // Save locally as reliable backup
      try {
        const stored = JSON.parse(localStorage.getItem('samya_survey_submissions') || '[]');
        stored.push(payload);
        localStorage.setItem('samya_survey_submissions', JSON.stringify(stored));
      } catch (e) {
        // quota exceeded or private mode
      }

      // Submit to Google Sheets Webhook
      const webhookUrl = (window as any).SAMYA_WEBHOOK_URL || (import.meta.env.PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL as string) || '';
      if (webhookUrl) {
        try {
          await fetch(webhookUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
        } catch (err) {
          console.error('Webhook dispatch error:', err);
        }
      }
    }

    // Modal Trigger Buttons
    document.querySelectorAll('[data-open-modal]').forEach(trigger => {
      trigger.addEventListener('click', () => {
        goToScreen(1);
        dialog.showModal();
      });
    });

    // Close Button & Done
    const closeBtn = document.getElementById('closeModalBtn');
    const doneBtn = document.getElementById('doneModalBtn');
    const finishNowBtn = document.getElementById('finishNowBtn');

    closeBtn?.addEventListener('click', () => dialog.close());
    doneBtn?.addEventListener('click', () => dialog.close());
    finishNowBtn?.addEventListener('click', async () => {
      await submitSurveyData('Initial Experience');
      dialog.close();
    });

    // Backdrop click close
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Screen 1: Start Survey
    document.getElementById('startSurveyBtn')?.addEventListener('click', () => goToScreen(2));

    // Screen 2: Registration form submit
    const regForm = document.getElementById('regForm') as HTMLFormElement | null;
    regForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (regForm.reportValidity()) {
        goToScreen(3);
      }
    });

    // Next & Back data-attributes
    dialog.querySelectorAll<HTMLElement>('[data-next]').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = parseInt(btn.dataset.next || '1', 10);
        goToScreen(next);
      });
    });

    dialog.querySelectorAll<HTMLElement>('[data-back]').forEach(btn => {
      btn.addEventListener('click', () => {
        const back = parseInt(btn.dataset.back || '1', 10);
        goToScreen(back);
      });
    });

    // Finish survey trigger
    const finishSurveyBtn = document.getElementById('finishSurveyBtn');
    finishSurveyBtn?.addEventListener('click', async () => {
      const origText = finishSurveyBtn.textContent;
      finishSurveyBtn.textContent = 'Submitting...';
      try {
        await submitSurveyData('Full Profile');
      } finally {
        finishSurveyBtn.textContent = origText;
        goToScreen(18);
      }
    });

    // Screen 5 & 13 Chip Toggle
    dialog.querySelectorAll<HTMLElement>('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        chip.classList.toggle('active');
      });
    });

    // Screen 6 Depth Tile Selection
    dialog.querySelectorAll<HTMLElement>('.depth-tile').forEach(tile => {
      tile.addEventListener('click', () => {
        dialog.querySelectorAll('.depth-tile').forEach(t => t.classList.remove('selected'));
        tile.classList.add('selected');
      });
    });
  }

  // Initialize on DOM load and view transitions
  document.addEventListener('DOMContentLoaded', initSurveyController);
</script>
