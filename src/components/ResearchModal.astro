---
// ResearchModal.astro - Master 18-screen interactive research survey experience
const depthTones = [
  { name: 'Very Light', color: '#F4E7DA', text: 'Fair' },
  { name: 'Light', color: '#ECCDB8', text: 'Light' },
  { name: 'Light-Medium', color: '#DCB496', text: 'Light-Med' },
  { name: 'Medium-Deep', color: '#B88158', text: 'Med-Deep' },
  { name: 'Deep', color: '#7B4728', text: 'Deep' },
  { name: 'Very Deep', color: '#452517', text: 'Very Deep' },
  { name: 'Not sure', color: '#E8DED6', text: '?', isUnknown: true }
];

const indianStates = [
  'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chandigarh', 
  'Chhattisgarh', 'Delhi NCR', 'Goa', 'Gujarat', 'Haryana', 
  'Himachal Pradesh', 'Jammu and Kashmir', 'Jharkhand', 'Karnataka', 
  'Kerala', 'Madhya Pradesh', 'Maharashtra', 'Manipur', 'Meghalaya', 
  'Mizoram', 'Nagaland', 'Odisha', 'Punjab', 'Rajasthan', 
  'Sikkim', 'Tamil Nadu', 'Telangana', 'Tripura', 'Uttar Pradesh', 
  'Uttarakhand', 'West Bengal'
];
---

<dialog id="research-modal" class="research-dialog" aria-modal="true" aria-labelledby="modal-step-title">
  <div class="dialog-wrapper">
    <!-- Top Modal Header -->
    <header class="modal-nav">
      <div class="modal-nav-left">
        <img src="/images/logo-dark.png" alt="Sāmya:" class="modal-logo" id="modalLogo" width="115" height="30" />
      </div>
      <div class="modal-nav-right">
        <span class="modal-phase-badge" id="modalPhaseBadge">THE JOURNEY</span>
        <button type="button" class="close-btn" id="closeModalBtn" aria-label="Close survey">✕</button>
      </div>
    </header>

    <!-- Top Linear Progress Line (visible on active question screens) -->
    <div class="progress-track" id="progressTrack" aria-hidden="true" hidden>
      <div class="progress-fill" id="progressFill" style="width: 14%;"></div>
    </div>

    <!-- Scrollable Modal Content Container -->
    <div class="dialog-body" id="dialogBody">

      <!-- ========================================== -->
      <!-- SCREEN 1: THE JOURNEY OVERVIEW             -->
      <!-- ========================================== -->
      <section class="survey-screen active" data-screen="1">
        <div class="journey-header">
          <p class="journey-eyebrow">THE JOURNEY</p>
          <h2 id="modal-step-title">Two short steps. One honest record of what India actually wears.</h2>
        </div>

        <div class="journey-cards-grid">
          <div class="journey-step-card">
            <span class="step-num teal">01</span>
            <h4>Tell us about your skin</h4>
            <p>Seven questions about your last foundation search, your shade depth, your undertone. No wrong answers.</p>
          </div>
          <div class="journey-step-card">
            <span class="step-num magenta">02</span>
            <h4>Shape the first shade range</h4>
            <p>Your responses feed directly into our research and the shades we formulate first for Indian skin tones.</p>
          </div>
          <div class="journey-step-card">
            <span class="step-num purple">03</span>
            <h4>Join shade testing</h4>
            <p>Interested? Complete a short shade profile and be considered for a complimentary shade-testing kit.</p>
          </div>
        </div>

        <div class="journey-matrix-card">
          <div class="matrix-img-wrap">
            <img src="/images/swatches-24.webp" alt="24 foundation liquid shade swatches" class="matrix-swatches" width="480" height="280" />
            <span class="matrix-badge">First shade-testing kits<br /><strong>In development now</strong></span>
          </div>
          <div class="matrix-info">
            <p class="info-eyebrow">WHY WE ASK</p>
            <h3>Your answers decide what we make first.</h3>
            <p>Every response helps us understand which depths, undertones and regions are most underserved today — and which shades belong in our first physical shade-testing kits. Selected participants may be invited to receive a complimentary kit and share their feedback.</p>
          </div>
        </div>

        <div class="journey-plum-cta">
          <h3>Your skin. Your shade. Your experience.</h3>
          <p>Tell us about your experience. Your responses will help shape our research and first shade-testing kits.</p>
          <button type="button" class="btn btn-white-pill" id="startSurveyBtn">
            BEGIN THE SURVEY →
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 2: REGISTRATION (STEP 0 - ABOUT YOU)-->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="2" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">STEP 0 — ABOUT YOU</p>
          <h2>Help us understand your experience.</h2>
          <p class="screen-sub">We're building a better approach to complexion products, starting with India's diverse skin tones. Help shape what comes next.</p>

          <form id="regForm" class="reg-form">
            <div class="input-group">
              <label for="fullName">FULL NAME</label>
              <input type="text" id="fullName" name="fullName" placeholder="Your name" required />
            </div>

            <div class="input-group">
              <label for="userEmail">EMAIL</label>
              <input type="email" id="userEmail" name="email" placeholder="Your email" required />
            </div>

            <div class="input-group">
              <label for="userPhone">PHONE NUMBER</label>
              <input type="tel" id="userPhone" name="phone" placeholder="+91" />
            </div>

            <label class="checkbox-label">
              <input type="checkbox" id="emailOptIn" name="optIn" checked />
              <span>I'd like to receive occasional updates from Sāmya: about launches and research findings. (Optional)</span>
            </label>

            <p class="form-disclaimer">We'll use your details to manage your research participation and contact you about shade-testing opportunities if you're interested. Submitting the research survey does not subscribe you to promotional communications.</p>

            <button type="submit" class="btn btn-wine btn-full">
              GET STARTED →
            </button>
          </form>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 3: LOCATION (WHERE ARE YOU BASED?)  -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="3" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 01</p>
          <h2>Where are you based?</h2>
          <p class="screen-sub">Climate, humidity, and sun exposure across India uniquely impact foundation wear.</p>

          <div class="input-group select-wrap">
            <label for="stateSelect">STATE / UNION TERRITORY</label>
            <select id="stateSelect" name="state" required>
              <option value="" disabled selected>Select your state or territory</option>
              {indianStates.map(st => (
                <option value={st}>{st}</option>
              ))}
            </select>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="2">← Back</button>
            <button type="button" class="btn btn-wine" data-next="4">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 4: PAST EXPERIENCE                  -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="4" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 02</p>
          <h2>Think about the last time you looked for foundation. What happened?</h2>
          <p class="screen-sub">Select one.</p>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="pastExp" value="matched_well" checked />
              <span class="radio-title">I found a shade that matched well.</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="pastExp" value="closest_available" />
              <span class="radio-title">I bought the closest available shade, but it wasn't quite right.</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="pastExp" value="couldnt_find" />
              <span class="radio-title">I couldn't find a suitable shade.</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="pastExp" value="found_not_bought" />
              <span class="radio-title">I found a suitable shade but didn't buy it.</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="pastExp" value="never_tried" />
              <span class="radio-title">I've never tried to find a foundation.</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="3">← Back</button>
            <button type="button" class="btn btn-wine" data-next="5">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 5: BIGGEST CHALLENGE (CHIPS)        -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="5" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 03</p>
          <h2>What has been your biggest challenge with foundation?</h2>
          <p class="screen-sub">Select up to two.</p>

          <div class="chip-grid">
            <button type="button" class="chip" data-val="undertone">Difficult to identify my undertone</button>
            <button type="button" class="chip active" data-val="oxidation">The shade looks different after wearing it.</button>
            <button type="button" class="chip" data-val="availability">My shade isn't consistently available</button>
            <button type="button" class="chip" data-val="testing">No opportunity to test properly</button>
            <button type="button" class="chip" data-val="seasonal">My skin tone changes through the year</button>
            <button type="button" class="chip" data-val="no_issues">I haven't faced any major difficulties</button>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="4">← Back</button>
            <button type="button" class="btn btn-wine" data-next="6">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 6: VISUAL SKIN TONE DEPTH SELECTOR  -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="6" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 04</p>
          <h2>Which skin-tone depth is closest to yours today?</h2>
          <p class="screen-sub">Choose the closest option.</p>

          <div class="depth-picker-grid">
            {depthTones.map((tone, idx) => (
              <button
                type="button"
                class={`depth-tile ${idx === 2 ? 'selected' : ''}`}
                data-tone={tone.name}
              >
                <span class="depth-swatch" style={`background-color: ${tone.color};`}>
                  {tone.isUnknown && <span class="unknown-q">?</span>}
                </span>
                <span class="depth-name">{tone.name}</span>
              </button>
            ))}
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="5">← Back</button>
            <button type="button" class="btn btn-wine" data-next="7">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 7: UNDERTONE SELECTION              -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="7" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 05</p>
          <h2>How would you describe your undertone?</h2>
          <p class="screen-sub">Select the undertone that best describes your complexion.</p>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="undertone" value="warm" checked />
              <span class="radio-title">Warm (Golden, yellow, peachy undertones)</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="undertone" value="cool" />
              <span class="radio-title">Cool (Rosy, pink, or reddish undertones)</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="undertone" value="neutral" />
              <span class="radio-title">Neutral (A balance of warm and cool)</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="undertone" value="olive" />
              <span class="radio-title">Olive (Subtle green or greenish-gold undertones)</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="undertone" value="unsure" />
              <span class="radio-title">I'm not sure</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="6">← Back</button>
            <button type="button" class="btn btn-wine" data-next="8">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 8: SEASONAL VARIATION               -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="8" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 06</p>
          <h2>Does your foundation shade change throughout the year?</h2>
          <p class="screen-sub">Sun exposure across Indian seasons often shifts complexion depth.</p>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="seasonalShift" value="yes_significantly" checked />
              <span class="radio-title">Yes, noticeably across seasons</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="seasonalShift" value="subtle" />
              <span class="radio-title">A subtle shift between summer and winter</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="seasonalShift" value="no" />
              <span class="radio-title">No, it stays fairly consistent</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="seasonalShift" value="not_sure" />
              <span class="radio-title">I'm not sure</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="7">← Back</button>
            <button type="button" class="btn btn-wine" data-next="9">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 9: TESTING PARTICIPATION INTEREST   -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="9" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">QUESTION 07</p>
          <h2>Would you be interested in testing Sāmya's developing shade range?</h2>
          <p class="screen-sub">Selected participants receive complimentary shade testing kits.</p>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="testingInterest" value="yes_love_to" checked />
              <span class="radio-title">Yes, I'd love to test samples on my skin</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="testingInterest" value="maybe" />
              <span class="radio-title">Maybe, depending on timing and details</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="testingInterest" value="just_feedback" />
              <span class="radio-title">No, just sharing research feedback</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="8">← Back</button>
            <button type="button" class="btn btn-wine" data-next="10">Submit Experience →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 10: MILESTONE SCREEN (WINE CANVAS)  -->
      <!-- ========================================== -->
      <section class="survey-screen wine-screen" data-screen="10" hidden>
        <div class="milestone-content">
          <span class="saved-pill">✓ YOUR RESPONSES ARE SAVED</span>
          <h2>Thank you for sharing<br /><em>your experience.</em></h2>
          <p class="milestone-sub">Your responses will help shape Sāmya's first complexion range. We'd love to learn a little more about your skin.</p>

          <div class="milestone-card">
            <p class="card-eyebrow">SHADE-TESTING KITS</p>
            <h3>Interested in receiving a complimentary shade-testing kit?</h3>
            <p>We're preparing physical shade-testing kits to help people discover their closest matches and contribute to our research. Answer a few additional questions to help us understand which shades may be most relevant for you. Selected participants will be invited to receive a complimentary kit and share their testing experience.</p>
            <span class="badge-time">JUST 2 MORE MINUTES</span>
          </div>

          <div class="milestone-actions">
            <button type="button" class="btn btn-yellow-pill" data-next="11">
              CONTINUE TO SHADE PROFILE →
            </button>
            <button type="button" class="btn btn-outline-white" id="finishNowBtn">
              FINISH FOR NOW
            </button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 11: CURRENT SHADE & BRAND           -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="11" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 01/07</p>
          <h2>Do you currently use a foundation? If yes, which one?</h2>
          <p class="screen-sub">Mention the brand and shade if you remember.</p>

          <div class="input-group">
            <label for="currentBrand">BRAND & SHADE NAME</label>
            <input type="text" id="currentBrand" placeholder="e.g. Maybelline Fit Me 228, MAC NC40" />
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="10">← Back</button>
            <button type="button" class="btn btn-wine" data-next="12">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 12: DAYLIGHT NECK VS FACE           -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="12" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 02/07</p>
          <h2>In natural daylight, how does your face compare to your neck?</h2>
          <p class="screen-sub">Select one.</p>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="neckComp" value="darker" checked />
              <span class="radio-title">My face is slightly darker than my neck</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="neckComp" value="lighter" />
              <span class="radio-title">My face is slightly lighter than my neck</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="neckComp" value="same" />
              <span class="radio-title">They match fairly closely</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="11">← Back</button>
            <button type="button" class="btn btn-wine" data-next="13">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 13: SIMPLIFIED MATCH PREFERENCE     -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="13" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 03/07</p>
          <h2>When choosing foundation, what would simplified shade match mean to you?</h2>
          <p class="screen-sub">Select what matters most.</p>

          <div class="chip-grid">
            <button type="button" class="chip active">Testing at home in natural light</button>
            <button type="button" class="chip">Knowing my undertone without guesswork</button>
            <button type="button" class="chip">A formula that doesn't oxidize darker</button>
            <button type="button" class="chip">Shades formulated specifically for Indian skin</button>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="12">← Back</button>
            <button type="button" class="btn btn-wine" data-next="14">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 14: CURRENT SKIN STATUS             -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="14" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 04/07</p>
          <h2>Compared with your usual skin tone, how does your skin look right now?</h2>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="skinNow" value="normal" checked />
              <span class="radio-title">About average / my standard depth</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="skinNow" value="tanned" />
              <span class="radio-title">More tanned than usual</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="skinNow" value="lighter" />
              <span class="radio-title">Lighter than usual</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="13">← Back</button>
            <button type="button" class="btn btn-wine" data-next="15">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 15: SELECTION CONFIDENCE            -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="15" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 05/07</p>
          <h2>How confident are you about the skin depth and undertone you selected earlier?</h2>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="confidence" value="very" checked />
              <span class="radio-title">Very confident</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="confidence" value="somewhat" />
              <span class="radio-title">Somewhat confident — I would love to test</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="confidence" value="unsure" />
              <span class="radio-title">Not confident — I usually guess</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="14">← Back</button>
            <button type="button" class="btn btn-wine" data-next="16">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 16: CITY / TOWN                     -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="16" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 06/07</p>
          <h2>Which city or town are you currently based in?</h2>
          <p class="screen-sub">This helps us plan sample distribution and regional testing cohorts.</p>

          <div class="input-group">
            <label for="cityName">CITY / TOWN</label>
            <input type="text" id="cityName" placeholder="e.g. Mumbai, Bengaluru, Delhi" />
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="15">← Back</button>
            <button type="button" class="btn btn-wine" data-next="17">Continue →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 17: FINAL CONSENT                   -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="17" hidden>
        <div class="screen-content">
          <p class="question-eyebrow">SHADE PROFILE | 07/07</p>
          <h2>If selected, would you be comfortable trying a few foundation samples and sharing your feedback?</h2>

          <div class="choice-group">
            <label class="radio-card">
              <input type="radio" name="sampleConsent" value="yes" checked />
              <span class="radio-title">Yes, I am happy to test and share honest feedback</span>
            </label>
            <label class="radio-card">
              <input type="radio" name="sampleConsent" value="no" />
              <span class="radio-title">I'd prefer not to test at this stage</span>
            </label>
          </div>

          <div class="survey-nav-row">
            <button type="button" class="btn btn-outline-back" data-back="16">← Back</button>
            <button type="button" class="btn btn-wine" id="finishSurveyBtn">Complete Profile →</button>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- SCREEN 18: COMPLETION STATE                -->
      <!-- ========================================== -->
      <section class="survey-screen" data-screen="18" hidden>
        <div class="complete-content">
          <div class="check-circle" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h2>Thank you for helping shape<br /><span class="brand-wine">Sāmya:</span></h2>
          <p class="complete-desc">Your shade profile is complete. If you're selected for a complimentary shade-testing kit, we'll be in touch at the email you provided. Selection is limited and completing the profile doesn't guarantee a kit.</p>
