---
---

<dialog id="research-modal" aria-labelledby="modal-title">
  <div class="modal-accent" aria-hidden="true"></div>
  <div class="modal-inner">
    <div class="modal-top">
      <p class="eyebrow" id="modal-step">01 / Get started</p>
      <button type="button" class="close" id="close-modal" aria-label="Close preview">×</button>
    </div>

    <!-- Stage 1 -->
    <div id="stage-one" class="modal-stage active">
      <h2 id="modal-title">Join our founding research.</h2>
      <p>Tell us a little about yourself to start the shade experience survey.</p>
      <div class="preview-notice">
        <strong>Interactive design preview.</strong> This form is not connected to a survey or database. Nothing you enter is submitted or saved.
      </div>
      <form id="registration-form">
        <div class="form-field">
          <label for="first-name">First name</label>
          <input 
            id="first-name" 
            type="text" 
            name="firstName" 
            placeholder="Your first name" 
            autocomplete="given-name" 
            required 
            maxlength="80" 
          />
        </div>
        <div class="form-field">
          <label for="email-address">Email address</label>
          <input 
            id="email-address" 
            type="email" 
            name="email" 
            placeholder="you@example.com" 
            autocomplete="email" 
            required 
            maxlength="255" 
          />
        </div>
        <button type="submit" class="btn modal-next">
          Continue to survey <span class="arrow" aria-hidden="true">→</span>
        </button>
      </form>
    </div>

    <!-- Stage 2 -->
    <div id="stage-two" class="modal-stage" hidden>
      <h2>Tell us about your shade experience.</h2>
      <p>Which part of finding foundation has been most difficult for you?</p>
      <div class="preview-notice">Preview only — your answers are not recorded.</div>
      <form id="shade-form">
        <span class="question-label">Choose the closest answer</span>
        <div class="choices">
          <label class="choice">
            <input type="radio" name="difficulty" value="Finding my undertone" required />
            <span>Finding my undertone</span>
          </label>
          <label class="choice">
            <input type="radio" name="difficulty" value="Finding shades to try" />
            <span>Finding enough shades to try</span>
          </label>
          <label class="choice">
            <input type="radio" name="difficulty" value="How foundation wears" />
            <span>How foundation looks after wearing it</span>
          </label>
          <label class="choice">
            <input type="radio" name="difficulty" value="Something else" />
            <span>Something else</span>
          </label>
        </div>
        <div class="form-field">
          <label for="notes">
            Anything else? <span style="font-weight:400;color:#887580">(optional)</span>
          </label>
          <textarea 
            id="notes" 
            name="notes" 
            placeholder="What would you like brands to understand?" 
            maxlength="1000"
          ></textarea>
        </div>
        <button type="submit" class="btn modal-next">
          Finish preview <span class="arrow" aria-hidden="true">→</span>
        </button>
      </form>
      <button class="back" id="go-back" type="button">← Back to details</button>
    </div>

    <!-- Stage 3 -->
    <div id="stage-three" class="modal-stage" hidden>
      <h2>Thank you for exploring Sāmya:.</h2>
      <p>This demonstrates the intended survey flow. No data has been collected. Connect your real survey or signup service before the page goes live.</p>
      <button type="button" class="btn modal-next" id="done-button">
        Close preview <span class="arrow" aria-hidden="true">↗</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  dialog {
    border: 0;
    padding: 0;
    max-width: 540px;
    width: calc(100% - 36px);
    max-height: calc(100% - 36px);
    background: var(--warm-white);
    color: var(--plum);
    box-shadow: 0 27px 90px rgba(20, 2, 16, .32);
    overflow-y: auto;
    position: fixed;
    inset: 0;
    margin: auto;
    opacity: 0;
    transform: scale(0.96) translateY(12px);
    transition: opacity 0.3s var(--ease-out-expo), transform 0.3s var(--ease-spring), display 0.3s allow-discrete, overlay 0.3s allow-discrete;
  }

  dialog[open] {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  @starting-style {
    dialog[open] {
      opacity: 0;
      transform: scale(0.96) translateY(12px);
    }
  }

  dialog::backdrop {
    background: rgba(22, 3, 18, .73);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    dialog[open]::backdrop {
      opacity: 0;
    }
  }

  .modal-accent {
    height: 5px;
    background: linear-gradient(90deg, var(--plum), var(--purple), var(--wine), var(--fuchsia), var(--yellow), var(--turquoise));
  }

  .modal-inner {
    padding: 34px 40px 43px;
    position: relative;
  }

  .modal-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .modal-top .eyebrow {
    font-size: 9px;
    margin: 0;
  }

  .close {
    font-size: 28px;
    line-height: 1;
    width: 34px;
    height: 34px;
    border: 0;
    background: transparent;
    color: var(--plum);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .close:hover {
    transform: scale(1.15) rotate(90deg);
    color: var(--wine);
  }

  .modal-stage {
    animation: stageFadeIn 0.35s var(--ease-out-expo) forwards;
  }

  @keyframes stageFadeIn {
    from {
      opacity: 0;
      transform: translateX(14px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .modal-inner h2 {
    font-family: var(--serif);
    font-size: 53px;
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: 1;
    margin: 27px 0 14px;
  }

  .modal-inner p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 17px;
  }

  .preview-notice {
    padding: 13px 15px;
    background: #F0E7EC;
    border-left: 3px solid var(--purple);
    font-size: 11px;
    line-height: 1.7;
    color: #5A4053;
    margin: 20px 0 23px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin: 18px 0;
  }

  .form-field label,
  .question-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .045em;
    color: var(--plum);
  }

  .form-field input,
  .form-field textarea {
    border: 1px solid #D3C3CD;
    background: #FFFEFC;
    border-radius: 0;
    color: var(--plum);
    padding: 13px 14px;
    min-height: 49px;
    width: 100%;
    font-size: 13px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--purple);
    box-shadow: 0 0 0 3px rgba(113, 20, 172, 0.12);
    outline: none;
  }

  .form-field textarea {
    min-height: 92px;
    resize: vertical;
  }

  .choices {
    display: grid;
    gap: 9px;
    margin: 18px 0 23px;
  }

  .choice {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px;
    border: 1px solid #DCCDD5;
    background: white;
    font-size: 12px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .choice:hover {
    border-color: var(--wine);
    transform: translateX(2px);
  }

  .choice:has(input:checked) {
    border-color: var(--purple);
    background: #F2EBF7;
  }

  .choice input {
    accent-color: var(--purple);
  }

  .modal-next {
    margin-top: 9px;
    width: 100%;
  }

  .back {
    display: inline-block;
    color: var(--wine);
    font-size: 11px;
    font-weight: 700;
    border: 0;
    background: none;
    text-decoration: underline;
    margin-top: 18px;
    padding: 5px 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--purple);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 540px) {
    .modal-inner {
      padding: 25px 22px 31px;
    }
    .modal-inner h2 {
      font-size: 43px;
    }
  }
</style>

<script>
  (function () {
    const modal = document.getElementById('research-modal') as HTMLDialogElement | null;
    if (!modal) return;

    const stages = [
      document.getElementById('stage-one'),
      document.getElementById('stage-two'),
      document.getElementById('stage-three')
    ];
    const label = document.getElementById('modal-step');
    const registration = document.getElementById('registration-form') as HTMLFormElement | null;
    const survey = document.getElementById('shade-form') as HTMLFormElement | null;
    const labels = ['01 / Get started', '02 / Shade survey', '03 / Preview complete'];

    function switchStage(n: number) {
      stages.forEach((el, i) => {
        if (!el) return;
        if (i === n) {
          el.hidden = false;
          el.classList.add('active');
        } else {
          el.hidden = true;
          el.classList.remove('active');
        }
      });

      if (label && labels[n]) {
        label.textContent = labels[n];
      }
      if (modal) {
        modal.scrollTop = 0;
      }

      const activeStage = stages[n];
      if (activeStage) {
        const title = activeStage.querySelector('h2');
        if (title) {
          title.setAttribute('tabindex', '-1');
          title.focus({ preventScroll: true });
        }
      }
    }

    // Modal triggers
    document.querySelectorAll('[data-open-modal]').forEach(button => {
      button.addEventListener('click', () => {
        switchStage(0);
        modal.showModal();
      });
    });

    document.getElementById('close-modal')?.addEventListener('click', () => modal.close());
    document.getElementById('done-button')?.addEventListener('click', () => modal.close());
    document.getElementById('go-back')?.addEventListener('click', () => switchStage(0));

    // Form Submissions
    registration?.addEventListener('submit', e => {
      e.preventDefault();
      if (registration.reportValidity()) {
        switchStage(1);
      }
    });

    survey?.addEventListener('submit', e => {
      e.preventDefault();
      if (survey.reportValidity()) {
        switchStage(2);
      }
    });

    // Close on backdrop click
    modal.addEventListener('click', e => {
      if (e.target === modal) {
        modal.close();
      }
    });

    modal.addEventListener('close', () => {
      registration?.reset();
      survey?.reset();
      switchStage(0);
    });
  })();
</script>
